ID!\n        $signature: String\n        $trackId: ID\n    ) {\n        removeUnifiedEntityFromRollingReminders(\n            input: {\n                unifiedEntityId: $entityId\n                signature: $signature\n                trackId: $trackId\n            }\n        ) {\n            ... on Video {\n                videoId\n                unifiedEntityId\n                playlistActions\n                isInPlaylist\n                isInRollingRemindersList\n                hasRecurringReleases\n            }\n        }\n    }\n":r.RemoveRollingRemindersDocument,"\n    fragment ResumableVideoCurrentStandalone on Video {\n        videoId\n        title\n    }\n":r.ResumableVideoCurrentStandaloneFragmentDoc,'\n    fragment ResumableVideoCurrentEpisode on Episode {\n        videoId\n\n        title\n        number\n        hideEpisodeNumbers: hasTitleBehavior(behavior: "hiddenEpisodeNumbers")\n        parentSeason {\n            videoId\n            number\n            title\n            numberLabel: numberLabelV2(label: ABBR)\n            hideEpisodeNumbers: hasTitleBehavior(\n                behavior: "hiddenEpisodeNumbers"\n            )\n        }\n    }\n':r.ResumableVideoCurrentEpisodeFragmentDoc,"\n    fragment ResumableVideo on Video {\n        videoId\n\n        ... on Movie {\n            ...ResumableVideoCurrentStandalone\n        }\n\n        ... on SportEvent {\n            unifiedEntityId\n            ...ResumableVideoCurrentStandalone\n        }\n\n        ... on Episode {\n            videoId\n            ...ResumableVideoCurrentEpisode\n        }\n\n        ... on Show {\n            currentEpisode {\n                videoId\n                ...ResumableVideoCurrentEpisode\n            }\n        }\n        ... on Season {\n            parentShow {\n                videoId\n                currentEpisode {\n                    ...ResumableVideoCurrentEpisode\n                }\n            }\n        }\n    }\n":r.ResumableVideoFragmentDoc,"\