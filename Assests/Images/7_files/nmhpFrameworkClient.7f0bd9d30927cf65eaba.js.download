oxArtWidth: Int!\n        $boxArtHeight: Int!\n        $backdropHeight: Int!\n    ) {\n        games(gameIds: $gameIds) {\n            title\n            artwork(\n                params: {\n                    artworkType: BOXSHOT\n                    features: { nonMemberBranding: true }\n                    dimension: { width: $boxArtWidth, height: $boxArtHeight }\n                }\n            ) {\n                url\n            }\n            artworks(\n                params: {\n                    artworkType: BILLBOARD\n                    dimension: { height: $backdropHeight }\n                }\n            ) {\n                url\n            }\n        }\n    }\n":r.GetGameInviteDataDocument,"\n    query GetLocpGenreMetadata($genreId: Int!) {\n        genres(genreIds: [$genreId]) {\n            ...LocpHeroMetadata\n        }\n    }\n":r.GetLocpGenreMetadataDocument,"\n    fragment LocpHeroMetadata on Genre {\n        __typename\n        genreId\n        name\n        types\n        hasNonMemberType\n        seoData {\n            browserTitle\n            descriptiveText\n            headline\n        }\n    }\n":r.LocpHeroMetadataFragmentDoc,"\n    query Videos($videoIds: [Int!]!) {\n        videos(videoIds: $videoIds) {\n            isPlayableOnAdsPlan\n            contentAdvisory {\n                maturityLevel\n            }\n            coreGenres {\n                edges {\n                    node {\n                        name\n                    }\n                }\n            }\n            hasOriginalTreatment\n            isAvailable\n            title\n            __typename\n            videoId\n            ... on Episode {\n                parentShow {\n                    videoId\n                }\n            }\n            personsActors: persons(roles: ACTOR) {\n                edges {\n                    node {\n                        name\n                    }\n                }\n            }\n            personsCreators: persons(roles: CREATOR) {\n                edges {\n                    node {\n                        name\n                    }\n                }\n            }\n            personsDirectors: persons(roles: DIRECTOR) {\n                edges {\n                    node {\n                        name\n                    }\n                }\n            }\n            ... on Season {\n                parentShow {\n                    videoId\n                }\n            }\n            ... on Supplemental {\n                ancestor {\n                    videoId\n                }\n            }\n            ... on Show {\n                artworkHero: artwork(\n                    params: {\n                        artworkType: STORY_ART\n                        format: PNG\n                        features: { nonMemberBranding: true }\n                    }\n                ) {\n                    url\n                }\n                artworkBillboard: artwork(\n                    params: {\n                        artworkType: BILLBOARD\n                        format: PNG\n                        features: {\n                            fallbackStrategy: STORY_ART\n                            nonMemberBranding: true\n                        }\n                    }\n                ) {\n                    url\n                }\n                shortSynopsis\n                seasons {\n                    totalCount\n                }\n            }\n            ... on Movie {\n                artworkHero: artwork(\n                    params: {\n                        artworkType: STORY_ART\n                        format: PNG\n                        features: { nonMemberBranding: true }\n                    }\n                ) {\n                    url\n                }\n                artworkBillboard: artwork(\n                    params: {\n                        artworkType: BILLBOARD\n                        format: PNG\n                        features: {\n                            fallbackStrategy: STORY_ART\n                            nonMemberBranding: true\n                        }\n                    }\n                ) {\n                    url\n                }\n                shortSynopsis\n            }\n        }\n    }\n":r.VideosDocument,"\n    mutation OAuth2Authorize($state: String, $codeChallenge: String) {\n        oAuth2Authorize(state: $state, codeChallenge: $codeChallenge) {\n            authorizationCode\n            state\n        }\n    }\n":r.OAuth2AuthorizeDocument,"\n    query GameDetailsQuery($gameIds: [Int!]!) {\n        games(gameIds: $gameIds) {\n            ...GamesLodpHero\n            ...GamesMoreDetailsFragment\n            ...GamesGallery\n            ...GamesMetadataFragment\n            ...GamesSEOMetadataFragment\n            ...GamesStructuredDataFragment\n            _id\n            unifiedEntityId\n            supportedLanguages\n            nGameImage: artwork(\n                params: {\n                    artworkType: BRAND_LOGO_CROPPED\n                    dimension: { height: 48 }\n                    features: {\n                        tone: LIGHT\n                        forceBrandLogo: N_GAMES\n                        nonMemberBranding: true\n                    }\n                }\n            ) {\n                url\n            }\n            qrIconImage: artwork(\n                params: {\n                    format: WEBP\n                    artworkType: APP_ICON\n                    dimension: { width: 150, height: 150 }\n                    features: {\n                        boxartForceUnbranded: true\n                        performNewContentCheck: false\n                        nonMemberBranding: true\n                    }\n                }\n            ) {\n                url\n            }\n            pageBackgroundImage: artwork(\n                params: {\n                    format: WEBP\n                    artworkType: BILLBOARD\n                    features: { nonMemberBranding: true }\n                }\n            ) {\n                url\n            }\n        }\n        growthPlans {\n            plans {\n                planId\n                price {\n                    priceInCents\n                    priceFormatted\n                }\n            }\n        }\n    }\n":r.GameDetailsQueryDocument,"\n    fragment GamesDownloadFragment on Game {\n        gameId\n        unifiedEntityId\n        iosInstallation {\n            appStoreId\n        }\n        androidInstallation {\n            packageName\n        }\n    }\n":r.GamesDownloadFragmentFragmentDoc,"\n    fragment GamesGallery on Game {\n        gameId\n        title\n        unifiedEntityId\n        orientation\n        landscapeScreenshots: artworks(\n            params: {\n                format: WEBP\n                artworkType: GAME_ART_HORIZONTAL\n                dimension: { width: 500 }\n            }\n        ) {\n            key\n            url\n        }\n        portraitScreenshots: artworks(\n            params: {\n                format: WEBP\n                artworkType: GAME_ART_VERTICAL\n                dimension: { height: 500 }\n            }\n        ) {\n            key\n            url\n        }\n        trailers: supplementalVideosList(first: 6) {\n            edges {\n                node {\n                    videoId\n                    title\n                    runtimeSec\n                    trailerHorizontalImage: artwork(\n                        params: {\n                            format: WEBP\n                            artworkType: GAME_ART_HORIZONTAL\n                            features: { nonMemberBranding: true }\n                        }\n                    ) {\n                        url\n                    }\n                    trailerVerticalImage: artwork(\n                        params: {\n                            format: WEBP\n                            artworkType: GAME_ART_VERTICAL\n                            features: { nonMemberBranding: true }\n                        }\n                    ) {\n                        url\n                    }\n                    cloudTrailerHorizontalImage: artwork(\n                        params: {\n                            format: WEBP\n                            artworkType: GAME_CLOUD_BOXART_HORIZONTAL\n                            features: { nonMemberBranding: true }\n                        }\n                    ) {\n                        url\n                    }\n                    cloudTrailerVerticalImage: artwork(\n                        params: {\n                            format: WEBP\n                            artworkType: GAME_CLOUD_BOXART_VERTICAL\n                            features: { nonMemberBranding: true }\n                        }\n                    ) {\n                        url\n                    }\n                    ... on Supplemental {\n                        playableVideo: playableVideo(\n                            request: {\n                                encodingProfiles: NODRM_H264BPL30_HEAAC_MP4\n                            }\n                        ) {\n                            url\n                        }\n                    }\n                }\n            }\n        }\n        ...GamesGalleryRowElementBoxshotFragment\n    }\n":r.GamesGalleryFragmentDoc,"\n    fragment GamesGalleryRowElementBoxshotFragment on Game {\n        gameId\n        title\n    }\n":r.GamesGalleryRowElementBoxshotFragmentFragmentDoc,"\n    fragment GamesStructuredDataFragment on Game {\n        title\n        contextualSynopsis(context: { uiContext: ODP }) {\n            evidenceKey\n            text\n        }\n        gameId\n        # TODO(carloscastro): Use platform-specific orientation when this page no longer receives a generic Game.\n        orientation\n        deviceCategories\n        features {\n            minimumPlayers\n            maximumPlayers\n        }\n        contentAdvisory {\n            certificationValue\n        }\n        supportedLanguages\n        imageUrl: artwork(\n            params: {\n                format: WEBP\n                artworkType: BILLBOARD\n                dimension: { width: 1080 }\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            url\n        }\n        seoLandscapeScreenshots: artworks(\n            params: {\n                format: WEBP\n                artworkType: GAME_ART_HORIZONTAL\n                dimension: { width: 1000 }\n            }\n        ) {\n            url\n        }\n        seoPortraitScreenshots: artworks(\n            params: {\n                format: WEBP\n                artworkType: GAME_ART_VERTICAL\n                dimension: { height: 800 }\n            }\n        ) {\n            url\n        }\n        genres {\n            edges {\n                node {\n                    name\n                }\n            }\n        }\n        contentMetadata {\n            gameNumberOfPlayers {\n                label\n            }\n        }\n        iosInstallation {\n            appStoreId\n        }\n        androidInstallation {\n            packageName\n            appStoreUrl\n        }\n        promoVideo(context: { uiContext: BROWSE, supportsPlaygraph: true }) {\n            id\n            video {\n                __typename\n                videoId\n                title\n                ... on Supplemental {\n                    shortSynopsis\n                    availabilityStartTime\n                    displayRuntimeMs\n                    ...SupplementalPlayableVideoFragment\n                    trailerThumbnail: artwork(\n                        params: {\n                            format: WEBP\n                            artworkType: SDP\n                            dimension: { width: 1080 }\n                            features: {\n                                fallbackStrategy: STORY_ART\n                                nonMemberBranding: true\n                            }\n                        }\n                    ) {\n                        url\n                    }\n                }\n            }\n        }\n    }\n":r.GamesStructuredDataFragmentFragmentDoc,"\n    fragment GamesMetadataFragment on Game {\n        gameId\n        title\n        ...GamesDownloadFragment\n        contentAdvisory {\n            certificationValue\n            maturityDescription\n        }\n        contentMetadata {\n            gameNumberOfPlayers {\n                label\n            }\n            duration {\n                label\n            }\n        }\n        primaryGenres {\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n        contextualSynopsis(context: { uiContext: ODP }) {\n            evidenceKey\n            text\n        }\n        lodpTaglineMessage: taglineMessage(\n            taglineRequest: { typedUiContext: LOGGED_OUT_DP }\n        ) {\n            tagline\n        }\n    }\n":r.GamesMetadataFragmentFragmentDoc,"\n    fragment GamesBillboardVideoFragment on Supplemental {\n        videoId\n        __typename\n        ...SupplementalPlayableVideoFragment\n    }\n":r.GamesBillboardVideoFragmentFragmentDoc,"\n    fragment GamesLodpHero on Game {\n        gameId\n        ...GamesHeroContentFragment\n        title\n        heroImageSmall: artwork(\n            params: {\n                format: WEBP\n                artworkType: BILLBOARD\n                dimension: { width: 960 }\n                features: {\n                    nonMemberBranding: true\n                    fallbackStrategy: STORY_ART\n                }\n            }\n        ) {\n            url\n        }\n        heroImageMedium: artwork(\n            params: {\n                format: WEBP\n                artworkType: BILLBOARD\n                dimension: { width: 1280 }\n                features: {\n                    nonMemberBranding: true\n                    fallbackStrategy: STORY_ART\n                }\n            }\n        ) {\n            url\n        }\n        heroImageLarge: artwork(\n            params: {\n                format: WEBP\n                artworkType: BILLBOARD\n                dimension: { width: 1920 }\n                features: {\n                    nonMemberBranding: true\n                    fallbackStrategy: STORY_ART\n                }\n            }\n        ) {\n            url\n        }\n\n        # promoVideo is the reliable source for the hero trailer video.\n        # supplementalVideosList was previously used but returns empty for\n        # mobile games, while promoVideo works for both mobile and cloud.\n        # videoId and __typename at the video level are required by Apollo\n        # cache normalization (keyFields).\n        promoVideo(context: { uiContext: BROWSE, supportsPlaygraph: true }) {\n            id\n            video {\n                __typename\n                videoId\n                ... on Supplemental {\n                    title\n                    videoId\n                    ...GamesBillboardVideoFragment\n                }\n            }\n        }\n    }\n":r.GamesLodpHeroFragmentDoc,"\n    fragment GamesHeroContentFragment on Game {\n        gameId\n        unifiedEntityId\n        __typename\n        title\n        gameStudioImage: artwork(\n            params: {\n                artworkType: BRAND_LOGO_CROPPED\n                dimension: { height: 48 }\n                features: { tone: LIGHT, nonMemberBranding: true }\n            }\n        ) {\n            url\n        }\n        iconImage: artwork(\n            params: {\n                format: WEBP\n                artworkType: APP_ICON\n                dimension: { width: 200, height: 200 }\n                features: {\n                    boxartForceUnbranded: true\n                    performNewContentCheck: false\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            url\n        }\n        cloudGameTitleWithLogo: artwork(\n            params: {\n                artworkType: LOGO_BRANDED_STACKED\n                format: WEBP\n                features: {\n                    brandLogoAlign: CENTER\n                    nonMemberBranding: true\n                    brandPadGravity: CENTER\n                }\n            }\n        ) {\n            url\n        }\n        lodpTaglineMessage: taglineMessage(\n            taglineRequest: { typedUiContext: LOGGED_OUT_DP }\n        ) {\n            tagline\n        }\n    }\n":r.GamesHeroContentFragmentFragmentDoc,"\n    fragment GamesAudioSubtitlesFragment on Game {\n        gameId\n        supportedLanguages\n    }\n":r.GamesAudioSubtitlesFragmentFragmentDoc,"\n    fragment GamesAvailableOnFragment on Game {\n        gameId\n        deviceCategories\n    }\n":r.GamesAvailableOnFragmentFragmentDoc,"\n    fragment GamesCompatibilityFragment on Game {\n        gameId\n        deviceCompatibility\n    }\n":r.GamesCompatibilityFragmentFragmentDoc,"\n    fragment GamesControllerSupportFragment on Game {\n        gameId\n        features {\n            controllerInfo\n            hasControllerSupport\n        }\n    }\n":r.GamesControllerSupportFragmentFragmentDoc,"\n    fragment GamesDurationFragment on Game {\n        gameId\n        contentMetadata {\n            duration {\n                label\n            }\n        }\n    }\n":r.GamesDurationFragmentFragmentDoc,"\n    fragment GamesContextualEvidenceFragment on Game {\n        gameId\n        features {\n            modes\n        }\n    }\n":r.GamesContextualEvidenceFragmentFragmentDoc,"\n    fragment GamesGenresFragment on Game {\n        gameId\n        genres {\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n    }\n":r.GamesGenresFragmentFragmentDoc,"\n    fragment GamesMaturityRatingFragment on Game {\n        gameId\n        contentAdvisory {\n            i18nReasonsText\n            maturityDescription\n        }\n    }\n":r.GamesMaturityRatingFragmentFragmentDoc,"\n    fragment GamesMoreDetailsFragment on Game {\n        gameId\n        ...GamesGenresFragment\n        ...GamesPersonsFragment\n        ...GamesContextualEvidenceFragment\n        ...GamesPlayersFragment\n        ...GamesDurationFragment\n        ...GamesAudioSubtitlesFragment\n        ...GamesRequiresInternetFragment\n        ...GamesReleaseYearFragment\n        ...GamesMaturityRatingFragment\n        ...GamesCompatibilityFragment\n        ...GamesControllerSupportFragment\n        ...GamesAvailableOnFragment\n    }\n":r.GamesMoreDetailsFragmentFragmentDoc,"\n    fragment GamesPersonsFragment on Game {\n        gameId\n        developer {\n            name\n        }\n    }\n":r.GamesPersonsFragmentFragmentDoc,"\n    fragment GamesPlayersFragment on Game {\n        gameId\n        features {\n            maximumPlayers\n            minimumPlayers\n        }\n    }\n":r.GamesPlayersFragmentFragmentDoc,"\n    fragment GamesReleaseYearFragment on Game {\n        gameId\n        releaseYear\n    }\n":r.GamesReleaseYearFragmentFragmentDoc,"\n    fragment GamesRequiresInternetFragment on Game {\n        gameId\n        features {\n            requiresConnectivity\n        }\n    }\n":r.GamesRequiresInternetFragmentFragmentDoc,"\n    fragment GamesSEOMetadataFragment on Game {\n        gameId\n        title\n        contextualSynopsis(context: { uiContext: ODP }) {\n            evidenceKey\n            text\n        }\n        iosInstallation {\n            appStoreId\n        }\n        ogImageSdp: artwork(\n            params: {\n                format: JPG\n                artworkType: GAME_OPENGRAPH_BOXART_HORIZONTAL\n                dimension: { width: 1200 }\n                features: {\n                    nonMemberBranding: true\n                    suppressTop10Badge: true\n                    performNewContentCheck: false\n                    enableLockBadgeChecks: false\n                }\n            }\n        ) {\n            url\n            height\n            width\n        }\n    }\n":r.GamesSEOMetadataFragmentFragmentDoc,"\n    fragment LolomoEdges on LolomoRowListEdge {\n        index\n        node {\n            listId\n            title\n            ... on LolomoDefaultRow {\n                genreId\n                isAvailableToNonMembers\n            }\n            entitiesConnection(first: $titleCount) {\n                totalCount\n                pageInfo {\n                    hasNextPage\n                }\n                edges {\n                    unifiedEntity {\n                        unifiedEntityId\n                        ... on Genre {\n                            genreId\n                            title\n                        }\n                        ... on Show {\n                            videoId\n                            title\n                        }\n                        ... on Movie {\n                            videoId\n                            title\n                        }\n                    }\n                    artwork(\n                        params: {\n                            artworkType: BOXSHOT\n                            dimension: { width: 300 }\n                            format: PNG\n                            features: { nonMemberBranding: true }\n                        }\n                    ) {\n                        url\n                    }\n                }\n            }\n        }\n    }\n":r.LolomoEdgesFragmentDoc,"\n    fragment HeroCtaPlans on GrowthPlans {\n        plans {\n            planId\n            price {\n                priceInCents\n                priceFormatted\n            }\n        }\n    }\n":r.HeroCtaPlansFragmentDoc,"\n    fragment CollectionRowFragment on LolomoRow {\n        title\n        ... on LolomoDefaultRow {\n            genreId\n            isAvailableToNonMembers\n        }\n        entitiesConnection {\n            edges {\n                unifiedEntity {\n                    unifiedEntityId\n                    ... on Genre {\n                        genreId\n                        title\n                    }\n                    ... on Show {\n                        videoId\n                        title\n                    }\n                    ... on Movie {\n                        videoId\n                        title\n                    }\n                }\n                artwork(\n                    params: {\n                        artworkType: BOXSHOT\n                        dimension: { width: 300 }\n                        format: PNG\n                        features: { nonMemberBranding: true }\n                    }\n                ) {\n                    url\n                }\n            }\n        }\n    }\n":r.CollectionRowFragmentFragmentDoc,'\n    query LocpHeroMetadataAndLolomo(\n        $categoryId: String!\n        $rowCount: Int!\n        $titleCount: Int!\n        $isModernizedSignup: Boolean!\n        $collectionId: ID!\n        $hasCollectionId: Boolean!\n    ) {\n        tallPanelCollage: growthCollage(collageType: WEB_TALL_PANEL)\n            @skip(if: $hasCollectionId)\n        tallPanelCollectionCollage: growthCollectionCollage(\n            collageType: WEB_TALL_PANEL\n            collectionId: $collectionId\n        ) @include(if: $hasCollectionId)\n        plans: growthPlans {\n            ...LodpHeroPlans\n            ...Plans\n            offer @include(if: $isModernizedSignup) {\n                ...GrowthOfferFromPlans\n            }\n        }\n        newLolomo(\n            context: {\n                mapAnnotations: {\n                    billboardUIClient: "web"\n                    cacheResponseEnabled: true\n                    categoryId: $categoryId\n                    clientAppCapability: {\n                        clientAppCanHandlePageVideoContainerEvidenceRow: true\n                    }\n                    gpsModel: "saget"\n                    nonMemberRequest: true\n                }\n                cxuiAnnotations: {\n                    supportedBillboardTypes: [GENRE, STANDARD]\n                    platform: "web"\n                    uiVersion: "1.0.0"\n                    supportedLolomoFeatures: ["billboard"]\n                }\n            }\n        ) {\n            lolomoId\n            title\n            rowsConnection(first: $rowCount) {\n                totalCount\n                edges {\n                    ...LolomoEdges\n                }\n            }\n        }\n    }\n':r.LocpHeroMetadataAndLolomoDocument,"\n    query LodpTitleAndPlansPageQuery(\n        $videoId: Int!\n        $titleId: ID!\n        $opaqueImageFormat: ArtworkFormat!\n        $transparentImageFormat: ArtworkFormat!\n        $thumbnailVideoId: Int!\n        $hasValidThumbnailVideoId: Boolean!\n        $useBakedInPlayThumbnail: Boolean!\n        $useFromWatchSupplements: Boolean!\n        $isModernizedSignup: Boolean!\n    ) {\n        trifectaRows: growthVideoCollections(\n            collectionsInput: {\n                collectionInputs: [{ collectionType: TRENDING_NOW, limit: 10 }]\n            }\n        ) {\n            __typename\n            collections {\n                ...TitleRowFragment\n            }\n        }\n        videos(videoIds: [$videoId]) {\n            # __typename and videoId is required for the generated queries to work.\n            __typename\n            videoId\n            title\n            ...NMTitleHeadFragment\n            ...LodpTrailers\n            # MoreDetailsFragment is globally available via the generated queries harness in Shakti and is defined in\n            # MoreDetails.tsx\n            ...MoreDetailsFragment\n            ...LodpHero\n            ...MoreLikeThisFragment\n            ...LodpPageBackgroundFragment\n            ...MetadataLodpFragment\n            ...EpisodesSectionFragment\n            ...LiveTitleFragment\n            ...LiveTaglineMessagesFragment\n            ...ThumbnailClips\n            ...BakedInPlayArtworkFragment @include(if: $useBakedInPlayThumbnail)\n        }\n        customThumbnail: videos(videoIds: [$thumbnailVideoId])\n            @include(if: $hasValidThumbnailVideoId) {\n            __typename\n            videoId\n            ...Boxshot600Fragment\n            ...ShareThumbnailArtworkFragment\n                @include(if: $useFromWatchSupplements)\n            ... on Supplemental @include(if: $useFromWatchSupplements) {\n                ...BillboardVideoFragment\n            }\n        }\n        plans: growthPlans {\n            ...LodpHeroPlans\n            ...Plans\n            offer @include(if: $isModernizedSignup) {\n                ...GrowthOfferFromPlans\n            }\n        }\n        growthTitleAccess(titleId: $titleId) {\n            requiresContentAddOn\n            requiresAdFreePlan\n        }\n    }\n":r.LodpTitleAndPlansPageQueryDocument,"\n    fragment MoreLikeThisFragment on Video {\n        similarVideos {\n            videoId\n            ...TitleRowElementBoxshotFragment\n        }\n    }\n":r.MoreLikeThisFragmentFragmentDoc,"\n    fragment TitleRowFragment on GrowthVideoCollection {\n        videos {\n            __typename\n            videoId\n            ...TitleRowElementBoxshotFragment\n        }\n    }\n":r.TitleRowFragmentFragmentDoc,"\n    fragment EpisodeFragment on Episode {\n        videoId\n        title\n        runtimeSec\n        shortSynopsis\n        number\n        ...MerchStill300\n    }\n":r.EpisodeFragmentFragmentDoc,"\n    fragment EpisodesSectionFragment on Video {\n        ... on Show {\n            seasons {\n                pageInfo {\n                    hasNextPage\n                }\n                edges {\n                    node {\n                        videoId\n                        numberLabelV2(label: LONG)\n                        shortTitle\n                        title\n                        totalDisplayRuntimeInSec\n                        showMemberType\n                        episodes {\n                            pageInfo {\n                                hasNextPage\n                            }\n                            edges {\n                                node {\n                                    videoId\n                                    ...EpisodeFragment\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n":r.EpisodesSectionFragmentFragmentDoc,"\n    fragment FacebookMetaFragment on Video {\n        videoId\n        title\n        shortSynopsis\n        ...UsePageTitleFragment\n        ...UseTitleHeadImageFragment\n        promoVideo(context: { uiContext: BILLBOARD }) {\n            video {\n                ... on Supplemental {\n                    ...SupplementalPlayableVideoFragment\n                }\n            }\n        }\n    }\n":r.FacebookMetaFragmentFragmentDoc,"\n    fragment TitleSchemaFragment on Video {\n        __typename\n        videoId\n        availabilityStartTime\n        shortSynopsis\n        title\n        actors: persons(roles: ACTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    personId\n                    name\n                }\n            }\n        }\n        directors: persons(roles: DIRECTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    personId\n                    name\n                }\n            }\n        }\n        creators: persons(roles: CREATOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    personId\n                    name\n                }\n            }\n        }\n        coreGenres {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n        contentAdvisory {\n            certificationValue\n        }\n        ... on Show {\n            latestYear\n            seasons {\n                totalCount\n            }\n        }\n        ...UseTitleHeadImageFragment\n        promoVideo(context: { uiContext: BILLBOARD }) {\n            video {\n                videoId\n                shortSynopsis\n                title\n                availabilityStartTime\n                ...BillboardOrStoryArt1280\n                ... on Supplemental {\n                    displayRuntimeMs\n                    ...SupplementalPlayableVideoFragment\n                }\n            }\n        }\n    }\n":r.TitleSchemaFragmentFragmentDoc,"\n    fragment NMTitleHeadFragment on Video {\n        videoId\n        shortSynopsis\n        ...FacebookMetaFragment\n        ...TitleSchemaFragment\n        ...UsePageTitleFragment\n    }\n":r.NMTitleHeadFragmentFragmentDoc,"\n    fragment UsePageTitleFragment on Video {\n        videoId\n        title\n        hasOriginalTreatment\n    }\n":r.UsePageTitleFragmentFragmentDoc,"\n    fragment UseTitleHeadImageFragment on Video {\n        videoId\n        ...BillboardOrStoryArt1280\n    }\n":r.UseTitleHeadImageFragmentFragmentDoc,"\n    fragment BillboardVideoFragment on Supplemental {\n        videoId\n        __typename\n        ...SupplementalPlayableVideoFragment\n    }\n":r.BillboardVideoFragmentFragmentDoc,"\n    fragment LodpHero on Video {\n        videoId\n        __typename\n        ...LodpHeroPromoFragment\n        ...HeroContentFragment\n        ...LodpHeroImages\n        ...LodpShareTaglineFragment\n    }\n":r.LodpHeroFragmentDoc,"\n    fragment LodpShareTaglineFragment on Video {\n        videoId\n        shareTaglineMessages: taglineMessages(\n            taglineRequest: { typedUiContext: ODP }\n        ) {\n            tagline\n            typedClassification\n        }\n    }\n":r.LodpShareTaglineFragmentFragmentDoc,"\n    fragment LodpHeroPromoFragment on Video {\n        __typename\n        promoVideo(context: { uiContext: BILLBOARD }) {\n            __typename\n            id\n            video {\n                __typename\n                videoId\n                ... on Supplemental {\n                    videoId\n                    ...HeroVideoModalFragment\n                    ...BillboardVideoFragment\n                }\n            }\n        }\n        ...LodpLiveTaglineMessagesFragment\n    }\n":r.LodpHeroPromoFragmentFragmentDoc,"\n    fragment LodpHeroPlans on GrowthPlans {\n        ...HeroCtaPlans\n    }\n":r.LodpHeroPlansFragmentDoc,"\n    fragment HeroContentFragment on Video {\n        videoId\n        ...HeroLogoFragment\n        ...LodpLiveTaglineMessagesFragment\n        ...LiveTitleFragment\n        ...LiveTaglineMessagesFragment\n    }\n":r.HeroContentFragmentFragmentDoc,"\n    fragment HeroLogoFragment on Video {\n        videoId\n        __typename\n        title\n        ...LogoHorizontalCropped350\n        ...BrandLogoCropped48h\n    }\n":r.HeroLogoFragmentFragmentDoc,"\n    fragment HeroVideoModalFragment on Supplemental {\n        videoId\n        title\n        ...SupplementalPlayableVideoFragment\n    }\n":r.HeroVideoModalFragmentFragmentDoc,"\n    fragment LodpHeroImages on Video {\n        videoId\n        ...EclipseBillboardRedux1920\n        ...EclipseBillboardRedux1280\n        ...BillboardOrStoryArt960\n    }\n":r.LodpHeroImagesFragmentDoc,"\n    fragment ContentWarningFragment on Video {\n        videoId\n        contentWarning {\n            message\n            url\n            urlSubstitutionString\n        }\n    }\n":r.ContentWarningFragmentFragmentDoc,"\n    fragment MetadataLodpFragment on Video {\n        videoId\n        ... on Show {\n            numSeasonsLabel\n        }\n        title\n        shortSynopsis\n        latestYear\n        primaryGenres {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    name\n                    genreId\n                }\n            }\n        }\n        ...PersonsMetadataFragment\n        contentAdvisory {\n            certificationValue\n        }\n        ...ContentWarningFragment\n        ...LiveTaglineMessagesFragment\n        ...LodpLiveTaglineMessagesFragment\n    }\n":r.MetadataLodpFragmentFragmentDoc,"\n    fragment PersonsMetadataFragment on Video {\n        videoId\n        actors: persons(roles: ACTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n        creators: persons(roles: CREATOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n    }\n":r.PersonsMetadataFragmentFragmentDoc,"\n    fragment AudioSubtitlesFragment on Video {\n        videoId\n        mediaTracks {\n            audioTracks {\n                language\n                __typename\n            }\n            subtitles {\n                language\n                __typename\n            }\n        }\n    }\n":r.AudioSubtitlesFragmentFragmentDoc,"\n    fragment ClassificationFragment on Video {\n        videoId\n        ...GenresFragment\n        isAvailableForDownload\n        ...TagEvidenceFragment\n        ...TudumLinkFragment\n    }\n":r.ClassificationFragmentFragmentDoc,"\n    fragment TagEvidenceFragment on Video {\n        videoId\n        tags {\n            id\n            displayName\n            isDisplayable\n        }\n    }\n":r.TagEvidenceFragmentFragmentDoc,"\n    fragment GenresFragment on Video {\n        videoId\n        genres {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    title\n                    genreId\n                }\n            }\n        }\n    }\n":r.GenresFragmentFragmentDoc,"\n    fragment MoreDetailsFragment on Video {\n        videoId\n        ...ClassificationFragment\n        ...PersonsFragment\n        ...AudioSubtitlesFragment\n    }\n":r.MoreDetailsFragmentFragmentDoc,"\n    fragment PersonsFragment on Video {\n        videoId\n        actors: persons(roles: ACTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n        creators: persons(roles: CREATOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n    }\n":r.PersonsFragmentFragmentDoc,"\n    fragment TudumLinkFragment on Video {\n        videoId\n        title\n        ... on Show {\n            tudumTitle {\n                slug\n            }\n        }\n        ... on Movie {\n            tudumTitle {\n                slug\n            }\n        }\n    }\n":r.TudumLinkFragmentFragmentDoc,"\n    fragment LodpPageBackgroundFragment on Video {\n        videoId\n        __typename\n        ...LodpHeroImages\n        ...LodpHeroPromoFragment\n    }\n":r.LodpPageBackgroundFragmentFragmentDoc,"\n    fragment Plans on GrowthPlans {\n        plans {\n            planId\n            name\n            price {\n                priceFormatted\n                priceTier\n            }\n            tag\n            attributes {\n                videoQuality\n                audioQuality\n                hasAds\n            }\n        }\n    }\n":r.PlansFragmentDoc,"\n    fragment LodpTrailersData on Supplemental {\n        videoId\n        title\n        runtimeSec\n        type\n        artwork(\n            params: {\n                format: JPG\n                artworkType: MERCH_STILL\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            url\n        }\n        playableVideo(\n            request: { encodingProfiles: NODRM_H264BPL30_HEAAC_MP4 }\n        ) {\n            url\n        }\n    }\n":r.LodpTrailersDataFragmentDoc,"\n    fragment ThumbnailClips on Video {\n        thumbnailClips: supplementalVideosList(uiContext: CLIPS) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    videoId\n                    title\n                }\n            }\n        }\n    }\n":r.ThumbnailClipsFragmentDoc,'\n    fragment LodpTrailers on Video {\n        videoId\n        trailers: supplementalVideosList(types: ["TRAILER", "TEASER_TRAILER"]) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    ...LodpTrailersData\n                }\n            }\n        }\n    }\n':r.LodpTrailersFragmentDoc,"\n    fragment LogoHorizontalCropped350 on Video {\n        videoId\n        logoStackCropped350: artwork(\n            params: {\n                artworkType: LOGO_HORIZONTAL_CROPPED\n                dimension: { width: 350 }\n                format: $transparentImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.LogoHorizontalCropped350FragmentDoc,"\n    fragment MerchStill300 on Video {\n        videoId\n        merchStill300: artwork(\n            params: {\n                artworkType: MERCH_STILL\n                dimension: { width: 300 }\n                format: $transparentImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.MerchStill300FragmentDoc,"\n    fragment BrandLogoCropped48h on Video {\n        videoId\n        brandLogoCropped48h: artwork(\n            params: {\n                artworkType: BRAND_LOGO_CROPPED\n                dimension: { height: 48 }\n                features: { tone: LIGHT, nonMemberBranding: true }\n                format: $transparentImageFormat\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BrandLogoCropped48hFragmentDoc,"\n    fragment BillboardOrStoryArt1920 on Video {\n        videoId\n        billboardOrStoryArt1920: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 1920 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STORY_ART\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BillboardOrStoryArt1920FragmentDoc,"\n    fragment BillboardOrStoryArt1280 on Video {\n        videoId\n        billboardOrStoryArt1280: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STORY_ART\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BillboardOrStoryArt1280FragmentDoc,"\n    fragment BillboardOrStoryArt960 on Video {\n        videoId\n        billboardOrStoryArt960: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 960 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STORY_ART\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BillboardOrStoryArt960FragmentDoc,"\n    fragment EclipseBillboardRedux1280 on Video {\n        videoId\n        eclipseBillboardRedux1280: artwork(\n            params: {\n                artworkType: ECLIPSE_BILLBOARD_REDUX\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.EclipseBillboardRedux1280FragmentDoc,"\n    fragment EclipseBillboardRedux1920 on Video {\n        videoId\n        eclipseBillboardRedux1920: artwork(\n            params: {\n                artworkType: ECLIPSE_BILLBOARD_REDUX\n                dimension: { width: 1920 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.EclipseBillboardRedux1920FragmentDoc,"\n    fragment Boxshot600Fragment on Video {\n        videoId\n        Boxshot600: artwork(\n            params: {\n                artworkType: ECLIPSE_BOXART_SMALL\n                dimension: { width: 600 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: false }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.Boxshot600FragmentFragmentDoc,"\n    fragment BakedInPlayArtworkFragment on Video {\n        videoId\n        bakedInPlayArtwork: artwork(\n            params: {\n                artworkType: ECLIPSE_BOXART_BACKGROUND_PLAY_BUTTON\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BakedInPlayArtworkFragmentFragmentDoc,"\n    fragment ShareThumbnailArtworkFragment on Video {\n        videoId\n        bakedInPlayArtwork: artwork(\n            params: {\n                artworkType: ECLIPSE_BOXART_BACKGROUND_PLAY_BUTTON\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: false }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.ShareThumbnailArtworkFragmentFragmentDoc,"\n    fragment LiveTitleFragment on Video {\n        videoId\n        __typename\n        ... on Show {\n            isAvailable\n            nextLiveEvent {\n                isSvodAvailable\n                timeWindow {\n                    startTimeMs\n                }\n            }\n        }\n        ... on Movie {\n            isAvailable\n            liveEvent {\n                isSvodAvailable\n                timeWindow {\n                    startTimeMs\n                }\n            }\n        }\n        ... on Episode {\n            isAvailable\n            liveEvent {\n                isSvodAvailable\n                timeWindow {\n                    startTimeMs\n                }\n            }\n        }\n    }\n":r.LiveTitleFragmentFragmentDoc,"\n    fragment LiveTaglineMessagesFragment on Video {\n        __typename\n        videoId\n        ... on Show {\n            allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: false }\n                taglineRequest: {\n                    typedUiContext: EPISODE_LIST\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            nextEventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    eventType\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Movie {\n            allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: false }\n                taglineRequest: {\n                    typedUiContext: BOB\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Episode {\n            allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: false }\n                taglineRequest: {\n                    typedUiContext: BOB\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n    }\n":r.LiveTaglineMessagesFragmentFragmentDoc,"\n    fragment LodpLiveTaglineMessagesFragment on Video {\n        videoId\n        __typename\n        taglineMessages(\n            taglineRequest: {\n                typedUiContext: LOGGED_OUT_DP\n                supportsMessageBadging: true\n            }\n        ) {\n            tagline\n            badgePrefix\n            renderCountdownTimer\n        }\n        ... on Show {\n            loggedOutTaglines: allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: true }\n                taglineRequest: {\n                    typedUiContext: LOGGED_OUT_DP\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            nextEventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Movie {\n            loggedOutTaglines: allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: true }\n                taglineRequest: {\n                    typedUiContext: LOGGED_OUT_DP\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Episode {\n            loggedOutTaglines: allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: true }\n                taglineRequest: {\n                    typedUiContext: LOGGED_OUT_DP\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n    }\n":r.LodpLiveTaglineMessagesFragmentFragmentDoc,"\n    fragment FaqPlans on GrowthPlans {\n        plans {\n            price {\n                priceInCents\n                priceFormatted\n            }\n            attributes {\n                hasAds\n            }\n        }\n    }\n":r.FaqPlansFragmentDoc,"\n    query NmhpPageQuery(\n        $opaqueImageFormat: ArtworkFormat!\n        $transparentImageFormat: ArtworkFormat!\n        $shouldFetchTrending: Boolean!\n        $isModernizedSignup: Boolean!\n    ) {\n        trending: growthVideoCollections(\n            collectionsInput: {\n                collectionInputs: [{ collectionType: TRENDING_NOW, limit: 10 }]\n            }\n        ) @include(if: $shouldFetchTrending) {\n            __typename\n            collections {\n                ...TrendingSectionFragment\n            }\n        }\n        imageCollage: growthCollage(collageType: WEB)\n        plans: growthPlans {\n            ...HeroPlans\n            ...PromoBannerPlans\n            ...FaqPlans\n            offer @include(if: $isModernizedSignup) {\n                ...GrowthOfferFromPlans\n            }\n        }\n    }\n":r.NmhpPageQueryDocument,"\n    fragment HeroPlans on GrowthPlans {\n        plans {\n            price {\n                priceInCents\n                priceFormatted\n            }\n        }\n    }\n":r.HeroPlansFragmentDoc,"\n    fragment PromoBannerPlans on GrowthPlans {\n        plans {\n            price {\n                priceFormatted\n            }\n            attributes {\n                hasAds\n            }\n        }\n    }\n":r.PromoBannerPlansFragmentDoc,"\n    fragment Billboard960 on Video {\n        videoId\n        billboard960: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 960 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STORY_ART\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.Billboard960FragmentDoc,"\n    fragment LogoCropped400 on Video {\n        videoId\n        logoCropped400: artwork(\n            params: {\n                artworkType: LOGO_HORIZONTAL_CROPPED\n                dimension: { width: 400 }\n                format: $transparentImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.LogoCropped400FragmentDoc,"\n    fragment Boxshot200NoTop10NoRecentlyAdded on Video {\n        videoId\n        boxshot200NoTop10NoRecentlyAdded: artwork(\n            params: {\n                artworkType: BOXSHOT\n                dimension: { width: 200 }\n                features: {\n                    suppressTop10Badge: true\n                    performNewContentCheck: false\n                    nonMemberBranding: true\n                }\n                format: $opaqueImageFormat\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.Boxshot200NoTop10NoRecentlyAddedFragmentDoc,'\n    fragment TrendingTitleModalFragment on Video {\n        videoId\n        title\n        latestYear\n        shortSynopsis\n        isAvailable\n        contentAdvisory {\n            certificationValue\n        }\n        coreGenres {\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n        ...Billboard960\n        ...LogoCropped400\n        ...Boxshot200NoTop10NoRecentlyAdded\n\n        # The title of shows are things like "Season 1" and we need the actual\n        # show title for the alt text of the show logo.\n        ... on Season {\n            parentShow {\n                videoId\n                title\n            }\n        }\n    }\n':r.TrendingTitleModalFragmentFragmentDoc,"\n    fragment TrendingTitleFragment on Video {\n        ... on Season {\n            parentShow {\n                videoId\n            }\n        }\n        videoId\n        title\n        ...Boxshot200NoTop10NoRecentlyAdded\n    }\n":r.TrendingTitleFragmentFragmentDoc,"\n    fragment TrendingSectionFragment on GrowthVideoCollection {\n        videos {\n            __typename\n            videoId\n            ...TrendingTitleFragment\n            ...TrendingTitleModalFragment\n        }\n    }\n":r.TrendingSectionFragmentFragmentDoc,"\n    fragment Boxshot300 on Video {\n        videoId\n        boxshot300: artwork(\n            params: {\n                artworkType: BOXSHOT\n                dimension: { width: 300 }\n                features: {\n                    suppressTop10Badge: true\n                    performNewContentCheck: false\n                    nonMemberBranding: true\n                }\n                format: $opaqueImageFormat\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.Boxshot300FragmentDoc,"\n    fragment TitleRowElementBoxshotFragment on Video {\n        videoId\n        title\n        ...Boxshot300\n    }\n":r.TitleRowElementBoxshotFragmentFragmentDoc,"\n    fragment SupplementalPlayableVideoFragment on Supplemental {\n        videoId\n        playableVideo(\n            request: {\n                encodingProfiles: NODRM_H264MPL31_HEAAC_MP4\n                prefersNonLetterBoxedVideo: true\n            }\n        ) {\n            url\n        }\n    }\n":r.SupplementalPlayableVideoFragmentFragmentDoc,"\n    query OrderFinalSignupChargeDecline {\n        account {\n            signupChargeDeclineReason\n        }\n    }\n":r.OrderFinalSignupChargeDeclineDocument,"\n    mutation SecondaryLanguagesMutation(\n        $guid: ID!\n        $secondaryLanguages: [LanguageBCP47Code!]\n    ) {\n        editProfile(\n            input: { id: $guid, contentLanguages: $secondaryLanguages }\n        ) {\n            account {\n                profile(guid: $guid) {\n                    secondaryLanguages\n                }\n            }\n        }\n    }\n":r.SecondaryLanguagesMutationDocument,"\n    query OrderFinalAccountOwnerName {\n        growthAccount {\n            name {\n                firstName {\n                    ... on GrowthClearStringValue {\n                        value\n                    }\n                }\n            }\n        }\n    }\n":r.OrderFinalAccountOwnerNameDocument,"\n    mutation RecordOnrampImpression {\n        recordOnrampImpression {\n            success\n        }\n    }\n":r.RecordOnrampImpressionDocument,"\n    fragment SecondaryProfileDemoFragment on GrowthCollectEmailConsentInfo {\n        pipcConsentRequired\n        emailConsentLabelId\n        privacyStatementRequired\n        termsOfUseMinimumVerificationAge\n    }\n":r.SecondaryProfileDemoFragmentFragmentDoc,"\n    query SecondaryDemoCollectionPage($profileGuid: ID) {\n        currentProfile {\n            guid\n            name\n            isEligibleFor1PDataCollection\n        }\n        growthCollectEmailConsentInfo(\n            contextInput: {\n                growthInputNode: { inputUserJourneyNode: UPDATE_PROFILE_EMAIL }\n            }\n            collectEmailConsentInfoInput: {\n                collectEmailType: PROFILE_ADD_EMAIL\n                profileGuid: $profileGuid\n            }\n        ) {\n            ...SecondaryProfileDemoFragment\n        }\n    }\n":r.SecondaryDemoCollectionPageDocument,"\n    mutation GrowthCreateMfaChallenge(\n        $createMfaChallengeInput: GrowthCreateMfaChallengeInput!\n        $contextInput: GrowthContextInput!\n    ) {\n        growthCreateMfaChallenge(\n            createMfaChallengeInput: $createMfaChallengeInput\n            contextInput: $contextInput\n        ) {\n            ...GrowthMutationResponseFragment\n        }\n    }\n":r.GrowthCreateMfaChallengeDocument,"\n    fragment Artwork on Image {\n        key\n        url\n        width\n        height\n        available\n        status\n        focalPoint {\n            x\n            y\n        }\n    }\n":r.ArtworkFragmentDoc,"\n    fragment Bookmark on Viewable {\n        ... on Video {\n            videoId\n        }\n\n        runtimeSec\n        bookmark {\n            position\n        }\n    }\n":r.BookmarkFragmentDoc,"\n    fragment GrowthMutationResponseFragment on GrowthMutationResponse {\n        __typename\n        ... on GrowthNextNode {\n            userJourneyNodeName\n            treatment\n            intent {\n                value\n                category\n            }\n        }\n        ... on GrowthMutationError {\n            errorCode\n            errorType\n            errorMessage\n            debugInfo {\n                key\n                value\n            }\n            redirectNode {\n                userJourneyNodeName\n                treatment\n                intent {\n                    value\n                    category\n                }\n            }\n        }\n\n        ... on GrowthMutationTask {\n            id\n            pollingInterval\n        }\n    }\n":r.GrowthMutationResponseFragmentFragmentDoc,"\n    fragment LiveEventMetadata on LiveEvent {\n        availabilityStartTime\n        timeWindow {\n            # use availabilityStartTime instead of startTime here\n            endTime\n        }\n        event {\n            ... on Episode {\n                videoId\n                isAvailable\n            }\n\n            ... on Movie {\n                videoId\n                isAvailable\n            }\n\n            # LiveEventViewable's third implementer. No consumer reads a\n            # SportEvent-typed event yet, but leaving it unselected would make\n            # one silently resolve to an empty object.\n            ... on SportEvent {\n                videoId\n                unifiedEntityId\n                isAvailable\n            }\n        }\n    }\n":r.LiveEventMetadataFragmentDoc,"\n    fragment LiveVideo on Video {\n        videoId\n\n        ... on Show {\n            nextLiveEvent {\n                ...LiveEventMetadata\n            }\n        }\n\n        ... on LiveEventViewable {\n            liveEvent {\n                ...LiveEventMetadata\n            }\n        }\n    }\n":r.LiveVideoFragmentDoc,"\n    fragment LiveEventTaglines on Video {\n        videoId\n\n        ... on LiveEventInRealTimeWindow {\n            allTaglineMessagesByLiveState(\n                taglineRequest: {\n                    typedUiContext: $textEvidenceUiContext\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    typedClassification\n                    badgeDate\n                    badgePrefix\n                }\n                state\n            }\n        }\n    }\n":r.LiveEventTaglinesFragmentDoc,"\n    fragment VideoPlaylist on Video {\n        videoId\n        unifiedEntityId\n\n        isPlayable\n        isAvailable\n        unplayableCauses\n\n        isInPlaylist\n        isInRemindMeList\n     